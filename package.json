{
  "name": "zhiflow-admin",
  "version": "1.0.0",
  "private": true,
  "description": "智流商城（ZhiFlow）管理后台",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vite",
    "serve": "pnpm dev",
    "build": "rimraf dist && cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "report": "rimraf dist && vite build",
    "preview": "vite preview",
    "preview:build": "pnpm build && vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "node --experimental-strip-types --test \"tests/**/*.test.ts\"",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "lint:stylelint": "stylelint --cache --fix \"**/*.{html,vue,css,scss}\" --cache-location node_modules/.cache/stylelint/",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "keywords": [
    "zhiflow",
    "mall",
    "admin",
    "element-plus",
    "vue3",
    "vite",
    "typescript"
  ],
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@pureadmin/utils": "^2.5.0",
    "@smallwei/avue": "3.5.3",
    "@vueuse/core": "^10.11.0",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "animate.css": "^4.1.1",
    "axios": "^1.20.0",
    "dayjs": "^1.11.11",
    "dompurify": "^3.4.11",
    "echarts": "^5.6.0",
    "element-china-area-data": "^6.1.0",
    "element-plus": "^2.14.5",
    "js-cookie": "^3.0.5",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "path": "^0.12.7",
    "pinia": "^2.3.1",
    "qs": "^6.12.1",
    "responsive-storage": "^2.2.0",
    "sortablejs": "^1.15.2",
    "tippy.js": "^6.3.7",
    "vue": "^3.5.42",
    "vue-i18n": "^9.13.1",
    "vue-qr": "^4.0.9",
    "vue-router": "^4.6.4",
    "vue-tippy": "^6.4.3"
  },
  "devDependencies": {
    "@iconify-icons/ep": "^1.2.12",
    "@iconify-icons/ri": "^1.2.10",
    "@iconify/vue": "^4.1.2",
    "@intlify/unplugin-vue-i18n": "^4.0.0",
