    "cssnano": "^6.1.2",
    "jsdom": "^25.0.1",
    "oxlint": "^1.13.0",
    "postcss": "^8.4.38",
    "postcss-html": "^1.7.0",
    "postcss-import": "^16.1.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.3.2",
    "rimraf": "^5.0.7",
    "rollup-plugin-visualizer": "^5.14.0",
    "sass": "^1.83.1",
    "stylelint": "^16.12.0",
    "stylelint-config-recess-order": "^5.1.1",
    "stylelint-config-recommended-vue": "^1.5.0",
