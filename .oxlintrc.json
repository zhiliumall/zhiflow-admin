{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "browser": true,
    "node": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "style": "off",
    "pedantic": "off",
    "restriction": "off"
  },
  "plugins": [
    "typescript",
    "import",
    "unicorn",
    "node",
    "promise"
  ],
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "build/",
    "public/",
    "patches/",
    "vendor/",
    "unpackage/",
    "libs/public/",
    "uni_modules/",
    "**/*.min.js",
    "**/*.lock",
    "package-lock.json",
    "**/*.vue",
    "src/assets/iconfont*/"
  ],
  "rules": {
    "promise/no-callback-in-promise": "off"
  }
}
